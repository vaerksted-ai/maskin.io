#!/bin/sh
# Pre-push hook: runs the i18n source lint (Danish/Swedish pages) before anything leaves
# your machine. Opt in once per clone:
#
#   git config core.hooksPath .githooks
#
# Needs Node 18 or later. Bypass in an emergency with: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
node scripts_lint_i18n.mjs
